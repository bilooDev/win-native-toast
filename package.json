{
  "name": "win-native-toast",
  "version": "1.0.1",
  "description": "Production-grade Windows toast notifications for Node.js with progress support",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "type": "module",
  "files": [
    "dist",
    "bin/*.exe",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:native && npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "build:native": "dotnet publish ./native/ToastBridge/ToastBridge.csproj -c Release -o ./bin",
    "build:native:debug": "dotnet build ./native/ToastBridge/ToastBridge.csproj -c Debug -o ./bin",
    "clean": "rimraf dist bin",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:basic": "node examples/basic.js",
    "example:progress": "node examples/progress.js",
    "example:advanced": "node examples/advanced.js",
    "example:multi": "node examples/multi-progress.js"
  },
  "keywords": [
    "windows",
    "toast",
    "notification",
    "native",
    "progress",
    "win32",
    "electron-alternative"
  ],
  "author": "Bour Bilal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bilooDev/win-native-toast.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "bugs": {
    "url": "https://github.com/bilooDev/win-native-toast/issues"
  },
  "homepage": "https://github.com/bilooDev/win-native-toast"
}