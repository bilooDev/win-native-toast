/**
 * Progress Notification Example
 * 
 * Simulates a file download with progress updates
 * 
 * Run: node examples/progress.js
 */

import toast from '../dist/esm/index.js';

toast.debug(true);

// Track all active downloads
const downloads = new Map();

// Simulate a download with progress
async function simulateDownload() {
  const downloadId = 'download-1';
  const fileName = 'ubuntu-24.04-desktop-amd64.iso';
  const totalSize = 5.8; // GB

  console.log(`Starting download: ${fileName}`);

  // Start progress notification
  toast.progress.start(downloadId, {
    title: `Downloading ${fileName}`,
    message: 'Preparing download...',
    value: 0,
    appId: 'dz.gpro.delivery',
    status: '0%',
    group: 'downloads',
  });

  // Create download state object
  const downloadState = {
    downloadId,
    fileName,
    totalSize,
    progress: 0,
    interval: null,
    completed: false,
  };

  downloads.set(downloadId, downloadState);

  const startDownload = () => {
    if (downloadState.interval) return; // Already running

    downloadState.interval = setInterval(() => {
      downloadState.progress += Math.random() * 0.05; // Slower increment

      if (downloadState.progress >= 1) {
        downloadState.progress = 1;
        clearInterval(downloadState.interval);
        downloadState.interval = null;
        downloadState.completed = true;

        // Complete the download
        console.log('Download complete!');
        toast.progress.complete(downloadId, {
          showSuccessToast: true,
          successTitle: 'Download Complete',
          successMessage: `${fileName} has been downloaded`,
        });

        // Exit after a delay
        setTimeout(() => {
          console.log('\nExample finished. Shutting down...');
          toast.shutdown();
          process.exit(0);
        }, 5000);

        return;
      }

      const downloaded = (totalSize * downloadState.progress).toFixed(2);
      const status = `${(downloadState.progress * 100).toFixed(0)}% - ${downloaded} GB / ${totalSize} GB`;

      console.log(`Progress: ${status}`);

      toast.progress.update(downloadId, {
        value: downloadState.progress,
        status: status,
      });
    }, 1000); // Slower update interval (1 second)
  };

  const pauseDownload = () => {
    if (downloadState.interval) {
      clearInterval(downloadState.interval);
      downloadState.interval = null;
      console.log('Download paused - progress loop stopped');
    }
  };

  // Store pause/resume controls for the action handler
  downloadState.startDownload = startDownload;
  downloadState.pauseDownload = pauseDownload;

  // Start the download
  startDownload();
}

// Handle pause/resume/cancel from toast buttons
toast.on('action', (e) => {
  console.log(`\nAction: ${e.action} on ${e.id}`);

  const downloadState = downloads.get(e.id);
  if (!downloadState) {
    console.log(`No download found for ID: ${e.id}`);
    return;
  }

  switch (e.action) {
    case 'pause':
      console.log('Pausing download...');
      toast.progress.pause(e.id);
      downloadState.pauseDownload(); // Stop the download loop
      break;

    case 'resume':
      console.log('Resuming download...');
      toast.progress.resume(e.id);
      downloadState.startDownload(); // Restart the download loop
      break;

    case 'cancel':
      console.log('Cancelling download...');
      toast.progress.cancel(e.id);
      downloadState.pauseDownload(); // Stop the download loop
      downloads.delete(e.id);

      setTimeout(() => {
        toast.shutdown();
        process.exit(0);
      }, 1000);
      break;
  }
});

toast.on('dismissed', (e) => {
  console.log(`Toast ${e.id} dismissed: ${e.reason}`);
});

// Run
console.log('Progress Notification Example');
console.log('============================\n');

// Must init before using progress API
await toast.init();
simulateDownload().catch(console.error);
